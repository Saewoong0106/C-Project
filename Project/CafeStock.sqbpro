INSERT OR IGNORE INTO Ingredients (Name, Unit, MinStock) VALUES 
('바닐라 시럽', 'ml', 500),
('카라멜 시럽', 'ml', 500),
('카라멜 소스', 'g', 300),
('초코 소스', 'g', 500),
('연유', 'g', 500),
('녹차 파우더', 'g', 300),
('초코 파우더', 'g', 500),
('요거트 파우더', 'g', 500),
('아이스티 분말', 'g', 500),
('레몬 청', 'g', 1000),
('자몽 청', 'g', 1000),
('청포도 베이스', 'g', 1000),
('딸기 청', 'g', 1000),
('휘핑 크림', 'ml', 500),
('치즈 케이크', '개', 5),
('식빵', '장', 20),
('탄산수', 'ml', 2000),
('얼음', '개', 1000),
('물', 'ml', 10000),
('원두', 'g', 1000),
('우유', 'ml', 5000);

-- 2. [메뉴 추가] 이미 있으면 무시, 없으면 추가
INSERT OR IGNORE INTO MenuItems (Name, Price) VALUES 
('바닐라 라떼', 4500),
('카라멜 마키아또', 4800),
('카페 모카', 4800),
('연유 라떼', 4800),
('녹차 라떼', 4500),
('초코 라떼', 4000),
('고구마 라떼', 4500),
('플레인 요거트 스무디', 5000),
('딸기 스무디', 5500),
('쿠키 앤 크림 프라페', 5800),
('레몬 에이드', 4500),
('자몽 에이드', 4500),
('청포도 에이드', 4500),
('아이스티', 3500),
('치즈 케이크', 5500),
('허니 버터 브레드', 6000);

-- 3. [안전 장치] 추가하려는 메뉴들의 '기존 레시피'만 싹 지우기 (중복 방지)
-- (이미 카라멜 마키아또 레시피가 있어도, 여기서 지워지므로 아래에서 깔끔하게 다시 들어갑니다)
DELETE FROM Recipes WHERE MenuItemID IN (
    SELECT MenuItemID FROM MenuItems WHERE Name IN (
        '바닐라 라떼', '카라멜 마키아또', '카페 모카', '연유 라떼', '녹차 라떼', 
        '초코 라떼', '고구마 라떼', '플레인 요거트 스무디', '딸기 스무디', 
        '쿠키 앤 크림 프라페', '레몬 에이드', '자몽 에이드', '청포도 에이드', 
        '아이스티', '치즈 케이크', '허니 버터 브레드'
    )
);

-- 4. [레시피 연결] 깨끗한 상태에서 다시 연결

-- [커피 변형]
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='바닐라 라떼'), (SELECT IngredientID FROM Ingredients WHERE Name='원두'), 20;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='바닐라 라떼'), (SELECT IngredientID FROM Ingredients WHERE Name='우유'), 200;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='바닐라 라떼'), (SELECT IngredientID FROM Ingredients WHERE Name='바닐라 시럽'), 30;

-- 카라멜 마키아또
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='카라멜 마키아또'), (SELECT IngredientID FROM Ingredients WHERE Name='원두'), 20;
