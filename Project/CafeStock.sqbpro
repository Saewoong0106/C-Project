INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='카라멜 마키아또'), (SELECT IngredientID FROM Ingredients WHERE Name='카라멜 시럽'), 20;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='카라멜 마키아또'), (SELECT IngredientID FROM Ingredients WHERE Name='카라멜 소스'), 10;

-- 카페 모카
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='카페 모카'), (SELECT IngredientID FROM Ingredients WHERE Name='원두'), 20;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='카페 모카'), (SELECT IngredientID FROM Ingredients WHERE Name='우유'), 200;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='카페 모카'), (SELECT IngredientID FROM Ingredients WHERE Name='초코 소스'), 30;

-- 연유 라떼
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='연유 라떼'), (SELECT IngredientID FROM Ingredients WHERE Name='원두'), 20;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='연유 라떼'), (SELECT IngredientID FROM Ingredients WHERE Name='우유'), 200;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='연유 라떼'), (SELECT IngredientID FROM Ingredients WHERE Name='연유'), 30;

-- [논커피]
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='녹차 라떼'), (SELECT IngredientID FROM Ingredients WHERE Name='우유'), 200;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='녹차 라떼'), (SELECT IngredientID FROM Ingredients WHERE Name='녹차 파우더'), 30;

INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='초코 라떼'), (SELECT IngredientID FROM Ingredients WHERE Name='우유'), 200;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='초코 라떼'), (SELECT IngredientID FROM Ingredients WHERE Name='초코 파우더'), 30;

-- [에이드]
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='레몬 에이드'), (SELECT IngredientID FROM Ingredients WHERE Name='탄산수'), 200;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='레몬 에이드'), (SELECT IngredientID FROM Ingredients WHERE Name='레몬 청'), 50;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='레몬 에이드'), (SELECT IngredientID FROM Ingredients WHERE Name='얼음'), 10;

INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='자몽 에이드'), (SELECT IngredientID FROM Ingredients WHERE Name='탄산수'), 200;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='자몽 에이드'), (SELECT IngredientID FROM Ingredients WHERE Name='자몽 청'), 50;

-- [스무디]
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='딸기 스무디'), (SELECT IngredientID FROM Ingredients WHERE Name='우유'), 150;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='딸기 스무디'), (SELECT IngredientID FROM Ingredients WHERE Name='딸기 청'), 60;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='딸기 스무디'), (SELECT IngredientID FROM Ingredients WHERE Name='얼음'), 10;

-- [디저트]
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='허니 버터 브레드'), (SELECT IngredientID FROM Ingredients WHERE Name='식빵'), 1;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='허니 버터 브레드'), (SELECT IngredientID FROM Ingredients WHERE Name='휘핑 크림'), 30;
INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='허니 버터 브레드'), (SELECT IngredientID FROM Ingredients WHERE Name='카라멜 소스'), 20;

INSERT INTO Recipes (MenuItemID, IngredientID, Amount) SELECT (SELECT MenuItemID FROM MenuItems WHERE Name='치즈 케이크'), (SELECT IngredientID FROM Ingredients WHERE Name='치즈 케이크'), 1;</sql><current_tab id="0"/></tab_sql></sqlb_project>
